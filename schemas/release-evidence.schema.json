{
  "$id": "https://example.invalid/ztad/release-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["name", "digest", "size"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "artifact_identity": {
      "minLength": 1,
      "type": "string"
    },
    "attestation_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "protected_attestation": {
      "type": "boolean"
    },
    "provenance_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "sbom_attestation_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sbom_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_sha": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source_sha",
    "version",
    "release_fingerprint",
    "artifact_identity",
    "artifact_digests",
    "sbom_digest",
    "provenance_digest",
    "attestation_digest",
    "sbom_attestation_digest",
    "protected_attestation",
    "claim_boundary"
  ],
  "type": "object"
}
