{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["waiver_id", "control_id", "subject_sha_or_digest", "risk", "rationale", "owner", "approved_by", "created_at", "expires_at", "compensating_controls"],
  "properties": {
    "waiver_id": {"type": "string"},
    "control_id": {"type": "string"},
    "subject_sha_or_digest": {"type": "string"},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "rationale": {"type": "string", "minLength": 10},
    "owner": {"type": "string"},
    "approved_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
