{
  "$id": "https://example.invalid/ztad/evidence-subject.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "change_contract_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "policy_bundle_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "toolchain_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "repository",
    "change_contract_hash",
    "base_sha",
    "head_sha",
    "policy_bundle_hash",
    "toolchain_hash"
  ],
  "type": "object"
}
